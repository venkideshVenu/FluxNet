{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxNet",
  "version": "0.1.2",
  "identifier": "com.fluxnet.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FluxNet",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "pill",
        "create": false,
        "title": "FluxNet",
        "width": 232,
        "height": 32,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "x": 40,
        "y": 40,
        "dragDropEnabled": false,
        "url": "index.html"
      },
      {
        "label": "compact",
        "create": false,
        "title": "FluxNet",
        "width": 189,
        "height": 172,
        "x": 1680,
        "y": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "hud",
        "create": false,
        "title": "FluxNet HUD",
        "width": 300,
        "height": 36,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "x": 1680,
        "y": 200,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "copyright": "© 2026 Venkidesh Venu. All rights reserved.",
    "category": "Utility",
    "publisher": "Venkidesh Venu",
    "longDescription": "FluxNet is a lightweight real-time network monitoring desktop application with floating widget overlays, system tray integration, and historical bandwidth visualization.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "FluxNet",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "single-instance": null
  }
}
