{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluxnet",
  "version": "0.1.0",
  "identifier": "com.venki.fluxnet",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FluxNet",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "pill",
        "title": "FluxNet",
        "width": 270,
        "height": 54,
        "center": true,
        "minWidth": 270,
        "minHeight": 54,
        "maxHeight": 54,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "x": 40,
        "y": 40,
        "dragDropEnabled": false,
        "url": "index.html"
      },
      {
        "label": "compact",
        "title": "FluxNet",
        "width": 240,
        "height": 240,
        "x": 1680,
        "y": 420,
        "minWidth": 240,
        "minHeight": 240,
        "maxWidth": 240,
        "maxHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "hud",
        "title": "FluxNet HUD",
        "width": 240,
        "height": 200,
        "minWidth": 240,
        "minHeight": 200,
        "maxWidth": 240,
        "maxHeight": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "x": 1680,
        "y": 200,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Minimal real-time network meter",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
