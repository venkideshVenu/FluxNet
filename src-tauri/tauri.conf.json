{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluxnet",
  "version": "0.1.0",
  "identifier": "com.venki.fluxnet",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FluxNet",
        "width": 900,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "pill",
        "title": "FluxNet",
        "width": 270,
        "height": 54,
        "minWidth": 270,
        "minHeight": 54,
        "maxHeight": 54,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "x": 40,
        "y": 40,
        "dragDropEnabled": false,
        "url": "index.html"
      },
      {
        "label": "compact",
        "title": "FluxNet",
        "width": 240,
        "height": 240,
        "minWidth": 240,
        "minHeight": 240,
        "maxWidth": 240,
        "maxHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "x": 280,
        "y": 40,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "hud",
        "title": "FluxNet HUD",
        "width": 240,
        "height": 190,
        "minWidth": 240,
        "minHeight": 190,
        "maxWidth": 240,
        "maxHeight": 190,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "x": 40,
        "y": 280,
        "visible": false,
        "url": "index.html"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Minimal real-time network meter",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
