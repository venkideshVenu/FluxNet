{
  "name": "fluxnet",
  "private": true,
  "version": "0.1.2",
  "description": "Real-time network monitor for Windows with desktop widgets, a game overlay and local usage history",
  "keywords": [
    "network-monitor",
    "bandwidth",
    "windows",
    "tauri",
    "widget",
    "system-tray"
  ],
  "homepage": "https://github.com/venkideshVenu/FluxNet#readme",
  "bugs": {
    "url": "https://github.com/venkideshVenu/FluxNet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venkideshVenu/FluxNet.git"
  },
  "author": "Venkidesh Venu",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --port 1420",
    "build": "vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.11",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,css,html,json,md,yml,yaml}": "prettier --write"
  }
}
